# Supabase-Zugangsdaten (Supabase-Dashboard -> Project Settings -> API)
# Datei kopieren nach ".env.local" und Werte eintragen. Ohne Werte nutzt die App LocalStorage.
VITE_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
VITE_SUPABASE_ANON_KEY=dein-anon-public-key

# Optional: interne Endung für Benutzernamen (Login "max" = Konto "max@ddliga.local" in Supabase)
# VITE_LOGIN_DOMAIN=ddliga.local
